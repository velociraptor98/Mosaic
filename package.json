{
  "name": "mosaic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "smoke": "vite build --config scripts/smoke.vite.config.ts && node node_modules/.smoke/smoke.js",
    "dev:app": "node scripts/dev-electron.mjs",
    "build:main": "vite build --config electron/vite.config.ts && vite build --config electron/vite.preload.config.ts",
    "build:app": "npm run build && npm run build:main",
    "start:app": "npm run build:app && electron .",
    "smoke:app": "npm run build:app && MOSAIC_SMOKE=1 electron .",
    "verify:export": "npm run sample && node scripts/verify-export.mjs",
    "smoke:all": "npm run smoke && npm run smoke:app && npm run verify:export",
    "sample": "vite build --config scripts/sample-game.vite.config.ts && node node_modules/.sample-game/build.js samples",
    "sample:pdf": "npm run sample && electron scripts/sample-game/pdf.cjs \"samples/coin-rush-build-guide.html\" \"samples/Coin Rush - Build Guide.pdf\"",
    "icon": "vite build --config scripts/icon.vite.config.ts && node node_modules/.icon/make-icon.js",
    "pack": "npm run icon && npm run build:app && electron-builder --dir",
    "dist": "npm run icon && npm run build:app && electron-builder",
    "smoke:packed": "MOSAIC_SMOKE=1 release/mac-arm64/Mosaic.app/Contents/MacOS/Mosaic"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "phaser": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rolldown": "^1.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "description": "Mosaic \u2014 a scene editor for Phaser",
  "main": "dist-electron/main.mjs",
  "productName": "Mosaic",
  "author": "IKI Studios",
  "build": {
    "appId": "com.ikistudios.mosaic",
    "productName": "Mosaic",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/@rolldown/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    }
  }
}
